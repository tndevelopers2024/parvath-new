# Hostinger (Apache / LiteSpeed) configuration for the built site.
# Vite copies this file into dist/, which is uploaded to public_html.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One official address: send www to the bare domain.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Enquiry endpoint used by the contact form and the callback popup.
  RewriteRule ^api/enquiry/?$ api/enquiry.php [L]

  # Serve real files and folders as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A missing asset must be a 404, not the app's HTML.
  RewriteRule ^(api|assets|images|brand)/ - [L,R=404]
  RewriteRule \.[a-zA-Z0-9]+$ - [L,R=404]

  # Every other path is a page of the single-page app.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Always revalidate the HTML so a new deploy is picked up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# The mail settings file must never be served.
<Files "enquiry-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
